
# ==========================================
# MEDICHANNEL - GIT ATTRIBUTES
# ==========================================

# Automatic text file detection
* text=auto

# ------------------------------------------
# JAVA / SPRING BOOT
# ------------------------------------------
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Maven wrapper
mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# ------------------------------------------
# NEXT.JS / TYPESCRIPT / JAVASCRIPT
# ------------------------------------------
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# ------------------------------------------
# CONFIGURATION
# ------------------------------------------
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.env.example text eol=lf

# ------------------------------------------
# DATABASE
# ------------------------------------------
*.sql text eol=lf

# ------------------------------------------
# DOCUMENTATION
# ------------------------------------------
*.md text eol=lf
*.txt text eol=lf

# ------------------------------------------
# BINARY FILES
# ------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary
