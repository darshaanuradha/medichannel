
# ==========================================
# MEDICHANNEL - ROOT GITIGNORE
# ==========================================

# ------------------------------------------
# ENVIRONMENT VARIABLES / SECRETS
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template

# ------------------------------------------
# BACKEND - SPRING BOOT / MAVEN
# ------------------------------------------
/backend/target/
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
/backend/.mvn/wrapper/maven-wrapper.jar

# Spring Tool Suite / Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# ------------------------------------------
# FRONTEND - NEXT.JS / NODE.JS
# ------------------------------------------
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/dist/
/frontend/coverage/

/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions

/frontend/.vercel/

# TypeScript
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts

# ------------------------------------------
# TESTING
# ------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------
# IDE / EDITORS
# ------------------------------------------
.idea/
*.iws
*.iml
*.ipr

.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ------------------------------------------
# BUILD OUTPUTS
# ------------------------------------------
/build/
/dist/

# ------------------------------------------
# LOGS / DEBUG
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# OPERATING SYSTEM
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------
# CERTIFICATES / KEYS
# ------------------------------------------
*.pem

# ------------------------------------------
# VERCEL
# ------------------------------------------
.vercel/

# ------------------------------------------
